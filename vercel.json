{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ruta-administrativa",
      "destination": "/admin.html"
    },
    {
      "source": "/api/admin/docentes",
      "destination": "/api/admin/representatives?op=docentes"
    },
    {
      "source": "/api/admin/sesiones",
      "destination": "/api/admin/representatives?op=sesiones"
    },
    {
      "source": "/api/rep/login",
      "destination": "/api/rep/auth?op=login"
    },
    {
      "source": "/api/rep/logout",
      "destination": "/api/rep/auth?op=logout"
    },
    {
      "source": "/api/rep/me",
      "destination": "/api/rep/auth?op=me"
    },
    {
      "source": "/api/rep/offerings",
      "destination": "/api/rep/data?op=offerings"
    },
    {
      "source": "/api/rep/sessions",
      "destination": "/api/rep/data?op=sessions"
    },
    {
      "source": "/api/rep/session",
      "destination": "/api/rep/data?op=session"
    },
    {
      "source": "/api/sessions/validate",
      "destination": "/api/sessions/ops?__op=validate"
    },
    {
      "source": "/api/sessions/close",
      "destination": "/api/sessions/ops?__op=close"
    },
    {
      "source": "/api/sessions/teacher-signature",
      "destination": "/api/sessions/ops?__op=teacher-signature"
    },
    {
      "source": "/api/sessions/topics",
      "destination": "/api/sessions/ops?__op=topics"
    },
    {
      "source": "/api/sessions/teacher-saved-signature",
      "destination": "/api/sessions/ops?__op=teacher-saved-signature"
    }
  ]
}
